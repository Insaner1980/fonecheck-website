---
// The fonecheck privacy policy lives in the shared Finnvek policy. Cloudflare
// answers /privacy/ with a permanent redirect (public/_redirects); this page is
// only a fallback for hosts that ignore that file.
const target = 'https://finnvek.com/privacy/#fonecheck';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://finnvek.com/privacy/" />
    <title>Privacy policy | fonecheck</title>
  </head>
  <body>
    <p>The fonecheck privacy policy is part of the <a href={target}>Finnvek privacy policy</a>.</p>
  </body>
</html>
