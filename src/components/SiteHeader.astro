---
interface Props { home?: boolean; current?: string }
const { home = false, current } = Astro.props;
const prefix = home ? '' : '/';
const nav = [
  ['The app', `${prefix}#areas`, 'app'],
  ['Pricing', `${prefix}#pricing`, 'pricing'],
  ['Guides', '/guides/', 'guides'],
  ['FAQ', `${prefix}#faq`, 'faq'],
];
---
<div class="bar" data-menu-bar="main">
  <a class="wordmark" href="/"><img src="/fonecheck-logo.svg" alt="fonecheck" width="72" height="46" /></a>
  <!-- Menu button, only shown on phones. On phones the nav below turns into
       a panel that drops down under the header when this is tapped. -->
  <button class="burger" type="button" data-menu-btn aria-expanded="false" aria-controls="main-nav" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
  <nav id="main-nav" aria-label="Main navigation">
    {nav.map(([label, href, key], i) => (
      <a href={href} style={`--i:${i}`} aria-current={current === key ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</div>
<div class="ticks" aria-hidden="true"></div>

<!-- Compact copy of the header that stays at the top of the screen once the
     real header has scrolled away. The layout script shows it (html.scrolled).
     Screen readers and the keyboard use the real header above. -->
<div class="float" aria-hidden="true" data-menu-bar="float">
  <a class="float-mark" href="/" tabindex="-1"><img src="/fonecheck-logo.svg" alt="" width="47" height="30" /></a>
  <button class="burger" type="button" tabindex="-1" data-menu-btn aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav>
    {nav.map(([label, href, key], i) => (
      <a href={href} tabindex="-1" style={`--i:${i}`} class:list={{ on: current === key }}>{label}</a>
    ))}
  </nav>
</div>

<script>
  // Phone menu: the menu button opens and closes the nav panel under its header.
  // The panel closes when a link is tapped, on Escape, on a tap outside it,
  // when its header scrolls out of use, or when the screen grows to desktop size.
  const html = document.documentElement;
  const bars = [...document.querySelectorAll<HTMLElement>('[data-menu-bar]')];

  const setOpen = (bar: HTMLElement, open: boolean) => {
    if (bar.classList.contains('open') === open) return;
    bar.classList.toggle('open', open);
    const btn = bar.querySelector<HTMLButtonElement>('[data-menu-btn]');
    btn?.setAttribute('aria-expanded', String(open));
    if (bar.dataset.menuBar === 'main') btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  const closeAll = () => bars.forEach(b => setOpen(b, false));

  bars.forEach(bar => {
    bar.querySelector('[data-menu-btn]')?.addEventListener('click', () => setOpen(bar, !bar.classList.contains('open')));
    bar.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => setOpen(bar, false)));
  });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    bars.forEach(bar => {
      if (!bar.classList.contains('open')) return;
      setOpen(bar, false);
      bar.querySelector<HTMLElement>('[data-menu-btn]')?.focus();
    });
  });
  document.addEventListener('click', e => {
    bars.forEach(bar => { if (!bar.contains(e.target as Node)) setOpen(bar, false); });
  });

  // The main header scrolls away and the compact one slides out at the same
  // point, so an open panel on the header that is leaving is closed.
  new MutationObserver(() => {
    const scrolled = html.classList.contains('scrolled');
    bars.forEach(bar => {
      if ((bar.dataset.menuBar === 'main') === scrolled) setOpen(bar, false);
    });
  }).observe(html, { attributes: true, attributeFilter: ['class'] });

  matchMedia('(min-width: 621px)').addEventListener('change', e => { if (e.matches) closeAll(); });
</script>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 13px 30px;
    border-bottom: 3px solid var(--edge);
  }
  .wordmark { display: block; line-height: 0; }
  .wordmark img { display: block; width: auto; height: 46px; }
  .bar nav { display: flex; align-items: center; }
  .bar nav a { font-size: 13px; padding: 6px 18px; border-left: 1px solid var(--hairline); }
  .bar nav a:first-child { border-left: 0; }
  .bar nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .bar nav a[aria-current] { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }

  .ticks {
    height: 7px;
    background: repeating-linear-gradient(90deg, var(--edge) 0 1px, transparent 1px 9px);
    opacity: .5;
  }

  .float {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 31;
    height: var(--float-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 30px;
    background: var(--bg);
    transform: translateY(-100%);
    transition: transform 250ms ease;
  }
  :global(html.scrolled) .float { transform: none; }
  .float-mark { display: block; line-height: 0; }
  .float-mark img { display: block; width: auto; height: 30px; }
  .float nav { display: flex; align-items: center; }
  .float nav a { font-size: 13px; padding: 6px 18px; }
  .float nav a:last-child { padding-right: 0; }
  .float nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .float nav a.on { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  @media (prefers-reduced-motion: reduce) { .float { transition: none; } }

  /* ---------- menu button (phones only) ---------- */
  .burger {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
  }
  .burger span {
    grid-area: 1 / 1;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 320ms cubic-bezier(.2, .7, .2, 1), opacity 180ms ease;
  }
  .burger span:nth-child(1) { transform: translateY(-7px); }
  .burger span:nth-child(3) { transform: translateY(7px); }
  /* The three lines fold into a cross while the menu is open. */
  .open > .burger span:nth-child(1) { transform: rotate(45deg); }
  .open > .burger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .open > .burger span:nth-child(3) { transform: rotate(-45deg); }

  @media (max-width: 620px) {
    .bar { position: relative; gap: 14px; padding: 12px 18px; }
    .wordmark img { height: 40px; }
    .float { padding: 0 16px; }
    .float-mark img { height: 26px; }
    .burger { display: grid; }

    /* The nav becomes a panel under its header. It unrolls downwards and the
       links follow one after another. */
    .bar nav, .float nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 25;
      flex-direction: column;
      align-items: stretch;
      background: var(--bg);
      border-bottom: 3px solid var(--edge);
      box-shadow: 0 22px 28px -20px rgba(23, 24, 15, .55);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition: clip-path 260ms cubic-bezier(.4, 0, .2, 1), visibility 0s 260ms;
    }
    /* Sits just below the header's own bottom edge. */
    .bar nav { top: calc(100% + 3px); }
    .float nav { border-top: 1px solid var(--edge); }
    .open > nav {
      clip-path: inset(0 0 -40px 0);
      visibility: visible;
      transition: clip-path 380ms cubic-bezier(.2, .7, .2, 1), visibility 0s;
    }

    .bar nav a, .float nav a {
      display: block;
      padding: 15px 18px;
      font-size: 19px;
      letter-spacing: -.01em;
      border-left: 0;
      border-top: 1px solid var(--hairline);
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 160ms ease, transform 160ms ease;
    }
    .bar nav a:first-child, .float nav a:first-child { border-top: 0; }
    .float nav a:last-child { padding-right: 18px; }
    .open > nav a {
      opacity: 1;
      transform: none;
      transition: opacity 300ms ease, transform 380ms cubic-bezier(.2, .7, .2, 1);
      transition-delay: calc(90ms + var(--i) * 45ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span, .bar nav, .float nav, .bar nav a, .float nav a,
    .open > nav, .open > nav a { transition: none !important; }
  }
</style>
