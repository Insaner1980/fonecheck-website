---
import { Image } from 'astro:assets';
import overviewDark from '../assets/home-dark.png';
import overviewLight from '../assets/home-light.png';
import displayDark from '../assets/display.png';
import displayLight from '../assets/display-light.png';
import batteryDark from '../assets/battery.png';
import batteryLight from '../assets/battery-light.png';
import cameraDark from '../assets/camera.png';
import cameraLight from '../assets/camera-light.png';
import audioDark from '../assets/audio.png';
import audioLight from '../assets/audio-light.png';
import reportDark from '../assets/report.png';
import reportLight from '../assets/report-light.png';
const views = [
  { name: 'Overview', description: 'Your findings at a glance. Passed, warning and information states stay distinct.', images: [overviewDark, overviewLight] },
  { name: 'Display', description: 'Explore screen specifications, then check pixels and touch response yourself.', images: [displayDark, displayLight] },
  { name: 'Battery', description: 'See charge, temperature and available readings. Charge level is not battery health.', images: [batteryDark, batteryLight] },
  { name: 'Camera', description: 'Try the front and rear cameras, take a test photo and check the torch.', images: [cameraDark, cameraLight] },
  { name: 'Audio', description: 'Listen to guided audio tests and confirm what you hear.', images: [audioDark, audioLight] },
  { name: 'Report', description: 'Read score and coverage separately. Save and export your findings with the full version.', images: [reportDark, reportLight] },
];
---
<div class="app-preview" id="explore">
  <div class="view-choices" aria-label="Choose an app view" hidden>
    {views.map((view, index) => <button type="button" data-view={index} aria-pressed={index === 0}>{view.name}</button>)}
  </div>
  <div class="preview-stage">
    <div class="preview-orbit" aria-hidden="true"></div>
    <div class="preview-device">
      {views.map((view, index) => view.images.map((image, theme) =>
        <div data-screen={`${index}-${theme}`} hidden={index !== 0 || theme !== 0}>
          <Image src={image} alt={`fonecheck ${view.name.toLowerCase()} in the ${theme ? 'light' : 'dark'} theme. ${view.description}`} widths={[320, 540, 1080]} sizes="(max-width: 600px) 240px, 260px" format="webp" loading="eager" fetchpriority={index === 0 && theme === 0 ? 'high' : 'low'} />
        </div>
      ))}
    </div>
    <span class="preview-side-label mono" aria-hidden="true">REAL APP / YOUR POINT OF VIEW</span>
  </div>
  <div class="preview-toolbar">
    <div class="preview-themes" aria-label="Choose an app theme" hidden>
      <button type="button" data-app-theme="0" aria-pressed="true">Dark</button>
      <button type="button" data-app-theme="1" aria-pressed="false">Light</button>
    </div>
    <a class="enlarge-preview" href={overviewDark.src}>Enlarge view <span aria-hidden="true">↗</span></a>
  </div>
  <p class="preview-description" aria-live="polite">{views[0].description}</p>
  <p class="preview-note">Pre-release screenshots. Example results.</p>
  <noscript><p class="preview-note">More views: {views.slice(1).map(view => <a href={view.images[0].src}>{view.name} </a>)}</p></noscript>
  <script is:inline type="application/json" id="preview-data" set:html={JSON.stringify(views.map(view => ({ name: view.name, description: view.description, sources: view.images.map(image => image.src) })))} />
  <dialog class="screenshot-dialog" aria-label="Enlarged app screenshot">
    <form method="dialog"><button class="close-preview" autofocus>Close <span aria-hidden="true">×</span></button></form>
    <img class="enlarged-image" alt="" width="1080" height="2424" />
  </dialog>
</div>
<script>
  const root = document.querySelector<HTMLElement>('.app-preview')!;
  const data: { name: string; description: string; sources: string[] }[] = JSON.parse(root.querySelector('#preview-data')!.textContent!);
  const choices = root.querySelectorAll<HTMLButtonElement>('[data-view]');
  const themes = root.querySelectorAll<HTMLButtonElement>('[data-app-theme]');
  const screens = root.querySelectorAll<HTMLElement>('[data-screen]');
  const device = root.querySelector<HTMLElement>('.preview-device')!;
  const enlarge = root.querySelector<HTMLAnchorElement>('.enlarge-preview')!;
  const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
  const enlargedImage = dialog.querySelector<HTMLImageElement>('img')!;
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let view = 0;
  let theme = 0;
  const render = () => {
    screens.forEach(screen => { screen.hidden = screen.dataset.screen !== `${view}-${theme}`; });
    choices.forEach(button => button.setAttribute('aria-pressed', String(Number(button.dataset.view) === view)));
    themes.forEach(button => button.setAttribute('aria-pressed', String(Number(button.dataset.appTheme) === theme)));
    root.querySelector('.preview-description')!.textContent = data[view].description;
    enlarge.href = data[view].sources[theme];
  };
  root.querySelector('.view-choices')!.removeAttribute('hidden');
  root.querySelector('.preview-themes')!.removeAttribute('hidden');
  choices.forEach(button => button.addEventListener('click', () => { view = Number(button.dataset.view); render(); }));
  themes.forEach(button => button.addEventListener('click', () => { theme = Number(button.dataset.appTheme); render(); }));
  enlarge.addEventListener('click', event => {
    event.preventDefault();
    enlargedImage.src = enlarge.href;
    enlargedImage.alt = `${data[view].name}, ${theme ? 'light' : 'dark'} theme. ${data[view].description}`;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
  });
  dialog.addEventListener('close', () => { document.body.style.overflow = ''; enlarge.focus(); });
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  let touchStart: { x: number; y: number } | undefined;
  device.addEventListener('pointerdown', event => { if (event.pointerType === 'touch') touchStart = { x: event.clientX, y: event.clientY }; });
  device.addEventListener('pointercancel', () => { touchStart = undefined; });
  device.addEventListener('pointerup', event => {
    if (!touchStart) return;
    const dx = event.clientX - touchStart.x;
    const dy = event.clientY - touchStart.y;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) { view = (view + (dx < 0 ? 1 : -1) + data.length) % data.length; render(); }
    touchStart = undefined;
  });
  const stage = root.querySelector<HTMLElement>('.preview-stage')!;
  let frame = 0;
  stage.addEventListener('pointermove', event => {
    if (event.pointerType !== 'mouse' || motion.matches) return;
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      const bounds = stage.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - .5;
      const y = (event.clientY - bounds.top) / bounds.height - .5;
      device.style.transform = `rotateX(${-y * 5}deg) rotateY(${x * 7}deg)`;
    });
  });
  const resetTilt = () => { cancelAnimationFrame(frame); device.style.transform = ''; };
  stage.addEventListener('pointerleave', resetTilt);
  motion.addEventListener('change', resetTilt);
</script>
