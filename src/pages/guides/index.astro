---
import { getCollection } from 'astro:content';
import PageShell from '../../layouts/PageShell.astro';
import GuideCards from '../../components/GuideCards.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<PageShell
  title="Android phone guides | fonecheck"
  description="Practical guides to checking an Android phone: what to test when something looks wrong, how to read the result and what a check cannot tell you."
  heading="When something on your phone looks wrong."
  lead="Each guide takes one symptom and walks through what to check, in what order, and what the result does and does not prove."
  current="guides"
>
  <GuideCards guides={guides} />
</PageShell>

<style is:global>
  /* The list starts right under the heading line. */
  .shell > div.page-body { padding-top: clamp(4px, 1vw, 12px); }
</style>
