---
// Dark panel that points from a guide or a tool page to the app.
interface Props { heading?: string }
const { heading = 'Put your phone to the test.' } = Astro.props;
---
<aside class="cta">
  <h2>{heading}</h2>
  <p><slot /></p>
  <a class="cta-action" href="/#areas">See what it checks</a>
</aside>

<style>
  .cta { margin-top: clamp(44px, 5vw, 70px); padding: 28px 30px 30px; background: var(--mount); color: var(--bg); }
  h2 { margin: 0; font-size: clamp(24px, 2.6vw, 34px); font-weight: 500; letter-spacing: -.035em; line-height: 1.1; }
  p { margin: 14px 0 0; max-width: 48ch; font-size: 15px; line-height: 1.6; opacity: .88; }
  .cta-action {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 50px;
    margin-top: 22px;
    padding: 0 20px;
    background: var(--action);
    color: var(--action-ink);
    font-size: 14.5px;
    font-weight: 500;
  }
  .cta-action:hover { background: var(--action-hover); }

  @media (max-width: 620px) {
    .cta { padding: 22px 20px 24px; }
  }
</style>
