.704 257.4 207.391 260.217Z M262.643 284.557Q256.93 284.557 252.47 281.935Q248.009 279.313 245.465 274.696Q242.922 270.078 242.922 263.974Q242.922 257.791 245.465 253.135Q248.009 248.478 252.47 245.857Q256.93 243.235 262.643 243.235Q269.843 243.235 274.696 246.991Q279.548 250.748 280.878 257.165H272.739Q271.957 253.722 269.178 251.843Q266.4 249.965 262.565 249.965Q259.435 249.965 256.774 251.57Q254.113 253.174 252.509 256.265Q250.904 259.357 250.904 263.896Q250.904 267.261 251.843 269.883Q252.783 272.504 254.387 274.304Q255.991 276.104 258.104 277.004Q260.217 277.904 262.565 277.904Q265.148 277.904 267.222 277.083Q269.296 276.261 270.743 274.617Q272.191 272.974 272.739 270.704H280.878Q279.548 276.965 274.696 280.761Q269.843 284.557 262.643 284.557Z M312.887 283.617 295.904 263.426V283.617H288.078V227.27H295.904V260.765L311.165 244.174H320.635L303.73 262.174L322.748 283.617Z" /></svg>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var KEY = 'fc-intro-seen';
    var seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Adding ?intro to the address always plays it, for checking the animation.
    var force = /[?&]intro\b/.test(location.search);
    var intro = document.getElementById('intro');
    var motion = force || !reduce;

    // The hero's own entrance (see HeroCream) waits for this: fc-pre hides its
    // pieces before the first paint, fc-enter plays them in.
    var entered = false;
    function enter() {
      if (entered) return;
      entered = true;
      root.classList.add('fc-enter');
      window.__fcEnter = true;
      window.dispatchEvent(new Event('fc:enter'));
      setTimeout(function () { root.classList.remove('fc-pre', 'fc-enter'); }, 3400);
    }
    function enterWhenReady() {
      var go = function () { requestAnimationFrame(enter); };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
      else go();
    }

    if (!motion) { if (intro) intro.remove(); return; }
    root.classList.add('fc-pre');
    if (!intro || !intro.animate || (!force && seen)) { if (intro) intro.remove(); enterWhenReady(); return; }

    root.classList.add('fc-intro');
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);

    var logo = document.getElementById('introLogo');
    var cover = intro.querySelector('.intro-cover');
    var done = false;
    var flying = false;

    function finish() {
      if (done) return;
      done = true;
      enter();
      // Marked as seen only once it has played through, so an interrupted
      // load does not use it up.
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      root.classList.remove('fc-intro');
      intro.remove();
      if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
      window.removeEventListener('pointerdown', skip);
      window.removeEventListener('keydown', skip);
    }

    function fly() {
      if (flying || done) return;
      flying = true;
      setTimeout(enter, 320);
      var target = document.querySelector('.wordmark img');
      var from = logo.getBoundingClientRect();
      var ease = 'cubic-bezier(.76,0,.24,1)';
      cover.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 700, delay: 120, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'forwards' });
      if (!target || !from.width) {
        logo.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 400, fill: 'forwards' }).onfinish = finish;
        return;
      }
      var to = target.getBoundingClientRect();
      var s = to.width / from.width;
      var dx = to.left - from.left;
      var dy = to.top - from.top;
      // Shrink on a geometric curve so the size change feels even all the way
      // into the corner instead of the logo staying large until the very end.
      var frames = [];
      for (var i = 0; i <= 12; i++) {
        var p = i / 12;
        frames.push({ transform: 'translate(' + dx * p + 'px,' + dy * p + 'px) scale(' + Math.pow(s, p) + ')' });
      }
      logo.animate(frames, { duration: 900, easing: ease, fill: 'forwards' }).onfinish = finish;
    }

    function skip() {
      if (flying) return;
      clearTimeout(timer);
      intro.classList.add('is-skipped');
      fly();
    }

    var timer = setTimeout(fly, 1600);
    window.addEventListener('pointerdown', skip);
    window.addEventListener('keydown', skip);
    // Safety net: never leave the cover up.
    setTimeout(finish, 5000);
  })();
</script>

<style>
  .intro { display: none; }
  :global(html.fc-intro) { overflow: hidden; }
  :global(html.fc-intro .wordmark img) { visibility: hidden; }

  :global(html.fc-intro) .intro {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 100;
    cursor: default;
  }
  .intro-cover { position: absolute; inset: 0; background: var(--bg); }

  .intro-logo {
    position: relative;
    width: min(64vw, 540px, calc(52svh * 216 / 138));
    aspect-ratio: 216 / 138;
    transform-origin: 0 0;
    will-change: transform;
  }
  .intro-logo svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .w-fone { animation: from-left 1050ms cubic-bezier(.16,1,.3,1) both; }
  .w-check { animation: from-right 1050ms cubic-bezier(.16,1,.3,1) 90ms both; }
  .w-rule { transform-origin: 50% 50%; animation: rule 560ms cubic-bezier(.65,0,.35,1) 820ms both; }

  @keyframes from-left {
    from { transform: translateX(-70vw); opacity: 0; filter: blur(10px); }
    55% { filter: blur(0); }
    to { transform: none; opacity: 1; filter: none; }
  }
  @keyframes from-right {
    from { transform: translateX(70vw); opacity: 0; filter: blur(10px); }
    55% { filter: blur(0); }
    to { transform: none; opacity: 1; filter: none; }
  }
  @keyframes rule {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* Skipped mid-way: snap the pieces into place and let the flight run. */
  .intro.is-skipped svg { animation: none; }
</style>
