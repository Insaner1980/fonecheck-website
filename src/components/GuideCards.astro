---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// The guides page lists the guides like the contents page of a manual:
// one row per guide, a small illustration, the title and summary, and the
// category on the right. The whole row is the link.
// Illustrations live in src/assets/guides/<slug>.webp
const art = import.meta.glob<{ default: ImageMetadata }>('../assets/guides/*.webp', { eager: true });
const artFor = (id: string) => art[`../assets/guides/${id}.webp`]?.default;

interface Props { guides: CollectionEntry<'guides'>[] }
const { guides } = Astro.props;

---
<ol class="index" role="list">
  {guides.map(guide => (
    <li>
      <a class="row" href={`/guides/${guide.id}/`}>
        {artFor(guide.id)
          ? <Image class="art" src={artFor(guide.id)!} alt="" widths={[200, 400]} sizes="(max-width: 620px) 96px, 168px" loading="lazy" />
          : <span class="art art-empty" aria-hidden="true"></span>}
        <span class="text">
          <h2>{guide.data.title}</h2>
          <span class="desc">{guide.data.description}</span>
        </span>
        <span class="meta">
          <span>{guide.data.category}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .index { list-style: none; margin: 0; padding: 0; }
  .index li + li { border-top: 1px solid var(--rule); }

  .row {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr) 150px;
    grid-template-areas: 'art text meta';
    gap: 36px;
    align-items: center;
    padding: 26px 0;
    color: var(--ink);
  }

  .art {
    grid-area: art;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    background: #D8D2BD;
    border: 1px solid var(--rule);
    transition: border-color 150ms ease;
  }
  .art-empty { background: var(--panel); }

  .text { grid-area: text; display: block; }
  h2 {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.25;
    text-wrap: pretty;
  }
  .desc {
    display: block;
    margin-top: 8px;
    max-width: 64ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .meta {
    grid-area: meta;
    display: grid;
    gap: 6px;
    justify-items: end;
    text-align: right;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .row:hover h2 { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .row:hover .art { border-color: var(--action); }

  @media (max-width: 900px) {
    .row { grid-template-columns: 140px minmax(0, 1fr); grid-template-areas: 'art text' 'art meta'; gap: 10px 28px; }
    .meta { justify-items: start; text-align: left; display: flex; gap: 16px; }
  }
  @media (max-width: 620px) {
    .row { grid-template-columns: 96px minmax(0, 1fr); gap: 8px 18px; align-items: start; padding: 20px 0; }
    .desc { font-size: 14px; }
  }
</style>
