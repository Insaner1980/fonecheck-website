---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; eager?: boolean; class?: string; }
const { image, alt, eager = false, class: className = '' } = Astro.props;
---
<div class:list={['phone', className]}>
  <div class="phone-screen">
    <div class="phone-camera" aria-hidden="true"></div>
    <Image src={image} alt={alt} widths={[320, 480, 640]} sizes="(max-width: 600px) 260px, 320px" format="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  </div>
</div>
