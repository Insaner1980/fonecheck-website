---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="top">
    <div class="brand">
      <a class="wordmark" href="/"><img src="/fonecheck-logo-light.svg" alt="fonecheck" width="63" height="40" /></a>
      <p class="tagline">A closer look at the phone in your pocket.</p>
      <p class="status">Google Play, fall 2026. Android 8.0 and later.</p>
    </div>

    <nav class="col" aria-labelledby="footer-site">
      <p class="col-head" id="footer-site">fonecheck</p>
      <ul>
        <li><a href="/#areas">What it checks</a></li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="/guides/">Guides</a></li>
        <li><a href="/model-lookup/">Model code lookup</a></li>
        <li><a href="/#faq">Questions</a></li>
        <li><a href="https://finnvek.com/privacy/#fonecheck">Privacy</a></li>
      </ul>
    </nav>

    <nav class="col" aria-labelledby="footer-finnvek">
      <p class="col-head" id="footer-finnvek">Finnvek</p>
      <ul>
        <li><a href="https://finnvek.com/">About the maker</a></li>
        <li><a href="https://finnvek.com/#apps">Other apps</a></li>
        <li><a href="mailto:contact@finnvek.com">Contact</a></li>
      </ul>
    </nav>
  </div>

  <div class="bottom">
    <span>&copy; {year} <a href="https://finnvek.com/">Finnvek</a></span>
    <a href="#top">Back to top</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--mount);
    color: var(--bg);
    border: 3px solid var(--edge);
    border-top: 0;
    padding: clamp(36px, 4vw, 52px) 30px 0;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 40px clamp(48px, 7vw, 120px);
    padding-bottom: clamp(28px, 3.5vw, 44px);
  }

  .wordmark { display: inline-block; line-height: 0; }
  .wordmark img { display: block; width: auto; height: 40px; }
  .tagline { margin: 14px 0 0; max-width: 30ch; font-size: 15px; line-height: 1.55; opacity: .85; }
  .status {
    margin: 12px 0 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1.7;
    opacity: .66;
  }

  .col-head {
    margin: 0 0 12px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .66;
  }
  .col ul { list-style: none; margin: 0; padding: 0; }
  .col a { display: inline-block; padding: 4px 0; font-size: 14px; line-height: 1.45; }
  .col a:hover { text-decoration: underline; text-underline-offset: 4px; }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0 18px;
    border-top: 1px solid #D8D2BD2e;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .75;
  }
  .bottom a:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 760px) {
    .top { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .brand { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .site-footer { padding-left: 18px; padding-right: 18px; }
    .top { gap: 30px 24px; }
  }
</style>
