---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import GuideArt from './GuideArt.astro';
interface Props { guides: CollectionEntry<'guides'>[]; }
const { guides } = Astro.props;
---
<div class="guide-grid">
  {guides.map(guide => <article class="guide-card">
    <a href={`/guides/${guide.id}/`}>
      <GuideArt kind={guide.data.illustration} />
      <div class="guide-meta mono">{guide.data.category}</div>
      <h3>{guide.data.title}</h3>
      <p>{guide.data.description}</p>
      <span class="text-link">Read the guide <Arrow diagonal /></span>
    </a>
  </article>)}
</div>
