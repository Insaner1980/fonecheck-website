---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroPreview from '../components/HeroPreview.astro';
import Arrow from '../components/Arrow.astro';
import GuideCards from '../components/GuideCards.astro';
import { categories, faqs } from '../data/product';
const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base title="fonecheck — Get to know your Android. Inside out." description="Explore your Android with guided hardware checks and clear local reports. Coming to Google Play in fall 2026." dark>
  <section class="hero compact-hero" aria-labelledby="hero-title">
    <div class="hero-grid container">
      <div class="hero-copy">
        <p class="eyebrow release-label"><span class="status-dot" aria-hidden="true"></span>Coming to Google Play / Fall 2026</p>
        <h1 id="hero-title">Get to know<br />your phone.<br /><span>Inside out.</span></h1>
        <p class="hero-description">Buying used? Checking your own? Explore your Android’s hardware with guided checks and findings you can understand.</p>
        <a href="#explore" class="button button-orange">Try the preview <Arrow /></a>
        <p class="hero-invitation">Pick a view. Switch the theme. Look closer.</p>
        <div class="hero-specs mono"><span>14 diagnostic areas</span><span>Android 8.0+</span><span>11 app languages</span></div>
      </div>
      <HeroPreview />
    </div>
    <div class="hero-facts container"><span>No ads. No app account.</span><span>Reports stored on your phone.</span><a href="/privacy/">Your data, your choice ↗</a></div>
  </section>
  <section class="benefits-section container" aria-label="What you can do">
    <div class="benefits-grid">
      <article><span class="mono">01 / Explore</span><h2>Look beneath the surface.</h2><p>Get hardware information and try guided screen, camera, audio and other checks.</p></article>
      <article><span class="mono">02 / Understand</span><h2>See what needs attention.</h2><p>Keep passes, warnings and untested features distinct. A finding comes with context.</p></article>
      <article><span class="mono">03 / Keep</span><h2>Take the findings with you.</h2><p>Save, compare and export reports as PDF or JSON with the full version.</p></article>
    </div>
    <details class="all-areas" id="checks"><summary>See all 14 diagnostic areas <span class="details-toggle" aria-hidden="true">+</span></summary>
      <div class="category-grid">{categories.map(category => <div class="area-detail"><h3>{category.name}</h3><p>{category.detail}</p>{category.free && <span class="mono">Included free</span>}</div>)}</div>
      <p class="section-note">Available checks depend on hardware, Android version and permissions. Results are observations, not a condition certificate.</p>
    </details>
  </section>
  <section class="section pricing-section" id="pricing"><div class="container"><div class="section-heading"><div><p class="eyebrow">Free to start. Yours to explore.</p><h2>Start free.<br />Go a little deeper.</h2></div><p>One full-version purchase.<br />No subscription. No recurring fees.</p></div><div class="pricing-grid"><article class="price-plan"><span class="mono">The essentials</span><h3>A good place to start.</h3><div class="price">Free</div><p>Four diagnostic areas. No time limit.</p><ul><li>Device information</li><li>Display checks</li><li>Battery information</li><li>Sensor information and checks</li></ul><p class="plan-footnote">See the results of these areas without paying.</p></article><article class="price-plan full-plan"><div class="plan-heading"><span class="mono">The full picture</span><span class="small-label">One-time purchase</span></div><h3>Follow your curiosity.</h3><div class="price">€6.99<span> / once</span></div><p>All 14 areas, plus the tools to connect the findings.</p><ul><li>Everything in the free version</li><li>All 14 diagnostic areas and guided Full Check</li><li>Overall score and test coverage</li><li>Saved reports, history and compatible comparisons</li><li>Category retests and PDF / JSON export</li></ul><p class="plan-footnote">Full Check is a paid feature, with pricing shown before you start.</p></article></div><div class="pricing-note"><span class="status-dot" aria-hidden="true"></span><p>Planned launch pricing. Coming to Google Play in fall 2026. The app is not yet available.</p></div></div></section>

  <section class="section guides-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">A little useful knowledge</p><h2>Stay curious.</h2></div><a class="text-link" href="/guides/">All guides <Arrow diagonal /></a></div><GuideCards guides={guides} /></div></section>

  <section class="section faq-section" id="faq"><div class="container faq-grid"><div><p class="eyebrow">A few things worth knowing</p><h2>Good questions.<br />Clear answers.</h2><p>Something else on your mind?<br /><a class="text-link" href="/support/">Get in touch <Arrow diagonal /></a></p></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span class="details-toggle" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>

</Base>
