---
interface Props { kind: 'phone' | 'battery' | 'report'; }
const { kind } = Astro.props;
---
<div class:list={['guide-art', `art-${kind}`]} aria-hidden="true">
  <div class="art-grid"></div>
  {kind === 'phone' && <svg viewBox="0 0 360 220" fill="none"><rect x="130" y="23" width="100" height="174" rx="15" stroke="currentColor" stroke-width="2"/><rect x="140" y="37" width="80" height="146" rx="5" stroke="currentColor" opacity=".35"/><path d="m158 111 15 15 31-35" stroke="currentColor" stroke-width="4"/><path d="M100 49H74v28m186 66h26v28M74 143v28h26m160-122h26v28" stroke="currentColor" stroke-width="1.5"/><path d="M170 29h20" stroke="currentColor" stroke-width="2"/></svg>}
  {kind === 'battery' && <svg viewBox="0 0 360 220" fill="none"><rect x="82" y="68" width="184" height="88" rx="8" stroke="currentColor" stroke-width="2"/><path d="M271 91h8v42h-8" stroke="currentColor" stroke-width="2"/><path d="M96 83h36v58H96zm47 0h36v58h-36zm47 0h36v58h-36z" fill="currentColor" opacity=".65"/><path d="M82 177h184M82 171v12m46-12v12m46-12v12m46-12v12m46-12v12" stroke="currentColor" opacity=".4"/></svg>}
  {kind === 'report' && <svg viewBox="0 0 360 220" fill="none"><path d="M118 24h100l25 26v146H118V24Z" stroke="currentColor" stroke-width="2"/><path d="M218 24v28h25M135 120h90m-90 17h65m-65 17h90m-90 17h65" stroke="currentColor" opacity=".5"/><path d="m137 85 8 8 15-18" stroke="currentColor" stroke-width="3"/><path d="M174 85h51" stroke="currentColor" stroke-width="3"/></svg>}
</div>
