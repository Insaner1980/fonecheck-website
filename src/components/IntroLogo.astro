235 308.035 196.591Q310.461 194.948 311.635 192.13H319.461Q318.443 195.73 316.017 198.587Q313.591 201.443 310.03 203.087Q306.47 204.73 301.852 204.73ZM290.348 180.391H312.809Q312.574 175.461 309.522 172.683Q306.47 169.904 301.93 169.904Q298.722 169.904 296.061 171.352Q293.4 172.8 291.835 175.539Q290.661 177.574 290.348 180.391Z" /></svg>
    <svg class="w-rule" viewBox="108 147 216 138" focusable="false" preserveAspectRatio="none"><path fill="#D2502B" d="M108.0 213.378H324.0V217.682H108.0Z" /></svg>
