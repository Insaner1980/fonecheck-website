---
import InstrumentLayout from '../layouts/InstrumentLayout.astro';
import IntroLogo from '../components/IntroLogo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroCream from '../components/HeroCream.astro';
import AreasSection from '../components/AreasSection.astro';
import PricingSection from '../components/PricingSection.astro';
import GuidesSection from '../components/GuidesSection.astro';
import FaqSection from '../components/FaqSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LocalPrice from '../components/LocalPrice.astro';
import { regionPrices, basePrice } from '../data/prices';

const title = 'fonecheck | Android phone diagnostics';
const description = 'Test your Android phone’s screen, sound, cameras, battery and more across 14 areas, then keep a report you can compare. Coming to Google Play in fall 2026.';

// Structured data for search engines: the free download plus the
// full-version price in every listed country. Countries that share the same
// currency and amount are grouped into one offer.
const groups = new Map<string, { currency: string; amount: string; countries: string[] }>();
for (const [code, p] of Object.entries(regionPrices)) {
  const key = `${p.currency} ${p.amount}`;
  if (!groups.has(key)) groups.set(key, { currency: p.currency, amount: p.amount, countries: [] });
  groups.get(key)!.countries.push(code);
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'fonecheck', url: 'https://fonecheck.app/' },
    {
      '@type': 'SoftwareApplication',
      name: 'fonecheck',
      operatingSystem: 'Android 8.0 or later',
      applicationCategory: 'UtilitiesApplication',
      description,
      url: 'https://fonecheck.app/',
      isAccessibleForFree: true,
      offers: [
        { '@type': 'Offer', name: 'fonecheck (free download)', price: '0', priceCurrency: basePrice.currency },
        ...[...groups.values()].map(g => ({
          '@type': 'Offer',
          name: 'fonecheck full version (one-time in-app purchase)',
          price: g.amount,
          priceCurrency: g.currency,
          eligibleRegion: g.countries, // ISO 3166-1 country codes
        })),
      ],
    },
  ],
};
---
<InstrumentLayout title={title} description={description} skipTo="#hero-title">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <IntroLogo />
  <div class="home-header"><SiteHeader home /></div>
  <main>
    <HeroCream />
    <AreasSection />
    <PricingSection />
    <GuidesSection />
    <FaqSection />
  </main>
  <SiteFooter />
  <LocalPrice />
</InstrumentLayout>

<style>
  .home-header { border: 3px solid var(--edge); border-bottom: 0; background: var(--bg); }
</style>
