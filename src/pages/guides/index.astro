---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCards from '../../components/GuideCards.astro';
const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Phone guides — fonecheck" description="Practical guides to checking an Android phone, understanding battery information and reading your fonecheck report.">
  <div class="container"><header class="page-header"><p class="eyebrow">The fonecheck field guide</p><h1>A little knowledge.<br />A closer look.</h1><p class="lead">Practical ways to understand the phone in your pocket, and the one you might buy next.</p></header><section class="guide-index" aria-label="Phone guides"><GuideCards guides={guides} /></section></div>
</Base>
